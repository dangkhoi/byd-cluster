<?xml version="1.0" encoding="utf-8"?><!--
  Home cho màn RỘNG (đầu xe 1920×1080 → w1280dp; biến thể này phủ từ w960dp).

  Vì sao cần: bản dọc duy nhất xếp hai thẻ chồng nhau, nên trên màn xe thẻ Cluster Cast rơi HẲN xuống dưới
  vùng thấy được — mở app ra không thấy Cast ở đâu, phải cuộn mới biết nó tồn tại. Màn Cast đã có biến thể
  w960dp/w1280dp từ trước, chỉ Home là thiếu.

  Nguyên tắc lấy từ V1: mọi thứ trên MỘT màn, thao tác chính bấm được ngay, chi tiết mới phải đi sâu. Trên
  màn ngang thì "một màn" nghĩa là hai cột, không phải một cột dài.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/screen_pad">

    <TextView android:id="@+id/txt_app_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ClusterNav" android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title" android:fontFamily="sans-serif-medium" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:layout_marginBottom="10dp"
        android:text="Hai hệ thống độc lập · Navigation + HUD và Cluster Cast"
        android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">

        <!-- ── Cột trái: Navigation + HUD ─────────────────────────────────────────────────────────── -->
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:padding="@dimen/card_pad">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Navigation + HUD" android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_status" android:fontFamily="sans-serif-medium" />
                    <Switch android:id="@+id/switch_enabled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Bật"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <View android:id="@+id/dot_status" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                    <TextView android:id="@+id/txt_status" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Đang chờ nguồn" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Hai dòng trạng thái đứng cạnh nhau: chúng là một cặp, đọc cùng lúc. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/txt_lane_status" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Cụm: tắt" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/txt_hud_status" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="HUD: tắt" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <CheckBox android:id="@+id/cb_lane" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:minHeight="@dimen/touch_min" android:text="Bật đầu ra làn cụm độc lập"
                    android:textColor="@color/text_secondary" />
                <CheckBox android:id="@+id/cb_hud" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
                    android:text="Bật đầu ra HUD độc lập" android:textColor="@color/text_secondary" />

                                <!-- MỘT công tắc cho một mục đích. Hai phần bên dưới là hai nửa của cùng một cơ chế: nội suy
                trừ dần cự ly theo tốc độ xe giữa hai lần notification, còn bộ đọc màn Maps kéo mốc về đúng
                số thật. Tách làm hai checkbox là bày ra cơ chế thay vì ý định — và tệ hơn: tắt nội suy thì
                bộ đọc màn CHẠY MÀ VÔ NGHĨA, vì `refine()` bỏ qua khi chưa có mốc. -->
                <CheckBox android:id="@+id/cb_distance_assist" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
                android:textColor="@color/text_secondary"
                android:text="Hỗ trợ cự ly" />
                <Button android:id="@+id/btn_reconnect_nav" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:minHeight="@dimen/touch_min" android:background="@drawable/btn_outline"
                    android:text="Cấp quyền / kết nối lại" android:textAllCaps="false"
                    android:textColor="@color/brand" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btn_nav_stop" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:minHeight="@dimen/touch_min"
                        android:background="@drawable/btn_warning_outline" android:text="Dừng toàn bộ"
                        android:textAllCaps="false" android:textColor="@color/warn_amber" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ── Cột phải: Cluster Cast ──────────────────────────────────────────────────────────────── -->
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="@dimen/gap" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:padding="@dimen/card_pad">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Cluster Cast" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_status" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="Chạm nút nổi để chiếu app đang mở · chạm lại để về màn chính"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <View android:id="@+id/dot_cast" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                    <TextView android:id="@+id/txt_cast_status" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Sẵn sàng" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <FrameLayout android:id="@+id/cast_geometry_container" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/divider" />

                <CheckBox android:id="@+id/cb_autostart" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min" android:textColor="@color/text_secondary"
                    android:text="Tự khởi động: chiếu app này lên cụm khi mở ClusterNav" />
                <Spinner android:id="@+id/spinner_autostart_app" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="@dimen/touch_min" />

                <TextView android:id="@+id/cast_recovery_toggle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
                    android:layout_marginTop="14dp" android:text="Khắc phục sự cố"
                    android:textSize="@dimen/text_body" android:textColor="@color/brand" android:focusable="true"
                    android:contentDescription="Mở hoặc đóng nhóm hành động khắc phục sự cố" />
                <LinearLayout android:id="@+id/cast_recovery_actions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <Button android:id="@+id/cast_stop" android:contentDescription="Dừng Cluster Cast và trả đồng hồ"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:background="@drawable/btn_warning_outline" android:text="Dừng — trả đồng hồ" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_diagnostics" android:contentDescription="Mở chẩn đoán Cluster Cast chỉ đọc"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Chẩn đoán" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_retry" android:contentDescription="Thử kết nối Cluster Cast lại"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Thử kết nối lại" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_phone_disconnect" android:contentDescription="Mở hướng dẫn ngắt kết nối điện thoại"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Hướng dẫn ngắt kết nối điện thoại" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_recover_once" android:contentDescription="Thử phục hồi projection một lần"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Thử phục hồi một lần" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_physical_instruction" android:contentDescription="Mở hướng dẫn khôi phục vật lý"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Hướng dẫn thao tác vật lý" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_profile_setup" android:contentDescription="Mở thiết lập hồ sơ Android"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Mở thiết lập hồ sơ" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
