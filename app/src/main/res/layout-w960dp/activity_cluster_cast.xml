<?xml version="1.0" encoding="utf-8"?>
<!-- Cluster Cast screen. Uses the project's V1 design tokens (brand/surface/divider, card_bg,
     btn_primary, btn_outline, btn_warning_outline) so one action reads as primary instead of ten
     identical grey boxes. Rare recovery actions stay collapsed until asked for. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cast_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_pad">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cluster Cast" android:textSize="@dimen/text_title" android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="@dimen/card_pad" android:layout_marginTop="@dimen/gap">
            <TextView android:id="@+id/cast_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Đang đọc trạng thái…"
                android:textSize="@dimen/text_status" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/cast_selected" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="6dp" android:text="Chưa chọn app"
                android:textSize="@dimen/text_label" android:textColor="@color/text_secondary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cast_primary_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="@dimen/gap">
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
        </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:text="Đang chọn để chiếu"
                android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:fontFamily="sans-serif-medium" />
            <LinearLayout android:id="@+id/cast_chosen" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/cast_chosen_empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Chưa chọn app nào — chạm app bên dưới"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap" android:paddingBottom="6dp" android:text="Chọn app để chiếu"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <GridLayout android:id="@+id/cast_apps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:alignmentMode="alignBounds" />

        <Button android:id="@+id/cast_stop" android:contentDescription="Dừng Cluster Cast và trả đồng hồ"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp"
            android:background="@drawable/btn_warning_outline" android:text="Dừng — trả đồng hồ" android:textAllCaps="false"
            android:textSize="16sp" android:textColor="@color/btn_text" />
        <Button android:id="@+id/cast_diagnostics" android:contentDescription="Mở chẩn đoán Cluster Cast chỉ đọc"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Chẩn đoán" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        <TextView android:id="@+id/cast_recovery_toggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
            android:layout_marginTop="@dimen/gap" android:text="Khắc phục sự cố"
            android:textSize="@dimen/text_body" android:textColor="@color/brand" android:focusable="true"
            android:contentDescription="Mở hoặc đóng nhóm hành động khắc phục sự cố" />
        <LinearLayout android:id="@+id/cast_recovery_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone">
        <Button android:id="@+id/cast_retry" android:contentDescription="Thử kết nối Cluster Cast lại"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Thử kết nối lại" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        <Button android:id="@+id/cast_phone_disconnect" android:contentDescription="Mở hướng dẫn ngắt kết nối điện thoại"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Hướng dẫn ngắt kết nối điện thoại" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        <Button android:id="@+id/cast_recover_once" android:contentDescription="Thử phục hồi projection một lần"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Thử phục hồi một lần" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        <Button android:id="@+id/cast_physical_instruction" android:contentDescription="Mở hướng dẫn khôi phục vật lý"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Hướng dẫn thao tác vật lý" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        <Button android:id="@+id/cast_profile_setup" android:contentDescription="Mở thiết lập hồ sơ Android"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:background="@drawable/btn_outline" android:text="Mở thiết lập hồ sơ" android:textAllCaps="false"
            android:textSize="14sp" android:textColor="@color/btn_text" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
