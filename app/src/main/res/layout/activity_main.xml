<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/screen_pad">

        <TextView android:id="@+id/txt_app_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ClusterNav" android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="@dimen/gap"
            android:text="Hai hệ thống độc lập · Navigation + HUD và Cluster Cast"
            android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg" android:padding="@dimen/card_pad">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Navigation + HUD" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_status" android:fontFamily="sans-serif-medium" />
                <Switch android:id="@+id/switch_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Bật" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                <View android:id="@+id/dot_status" android:layout_width="12dp" android:layout_height="12dp"
                    android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                <TextView android:id="@+id/txt_status" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Đang chờ nguồn" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/txt_lane_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Cụm: tắt" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/txt_hud_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="HUD: tắt" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/cb_lane" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:minHeight="@dimen/touch_min" android:text="Bật đầu ra làn cụm độc lập"
                android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/cb_hud" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:minHeight="@dimen/touch_min" android:text="Bật đầu ra HUD độc lập"
                android:textColor="@color/text_secondary" />
                        <!-- MỘT công tắc cho một mục đích. Hai phần bên dưới là hai nửa của cùng một cơ chế: nội suy
            trừ dần cự ly theo tốc độ xe giữa hai lần notification, còn bộ đọc màn Maps kéo mốc về đúng
            số thật. Tách làm hai checkbox là bày ra cơ chế thay vì ý định — và tệ hơn: tắt nội suy thì
            bộ đọc màn CHẠY MÀ VÔ NGHĨA, vì `refine()` bỏ qua khi chưa có mốc. -->
            <CheckBox android:id="@+id/cb_distance_assist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
            android:textColor="@color/text_secondary"
            android:text="Hỗ trợ cự ly" />
            <Button android:id="@+id/btn_reconnect_nav" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:minHeight="@dimen/touch_min" android:background="@drawable/btn_outline"
                android:text="Cấp quyền / kết nối lại" android:textAllCaps="false" android:textColor="@color/brand" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btn_nav_stop" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp" android:minHeight="@dimen/touch_min"
                    android:background="@drawable/btn_warning_outline" android:text="Dừng toàn bộ"
                    android:textAllCaps="false" android:textColor="@color/warn_amber" />
                <Button android:id="@+id/btn_vietmap_widget_diag" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
                    android:minHeight="@dimen/touch_min" android:background="@drawable/btn_outline"
                    android:text="Dữ liệu VietMap" android:textAllCaps="false" android:textColor="@color/brand" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap" android:orientation="vertical"
            android:background="@drawable/card_bg" android:padding="@dimen/card_pad">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Cluster Cast" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_status" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Chạm nút nổi để chiếu app đang mở · chạm lại để về màn chính"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                <View android:id="@+id/dot_cast" android:layout_width="12dp" android:layout_height="12dp"
                    android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                <TextView android:id="@+id/txt_cast_status" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Sẵn sàng" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <FrameLayout android:id="@+id/cast_geometry_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" />

            <!-- Cast zone buttons: tap to pick app from list and cast to that zone -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">
                <Button android:id="@+id/cast_zone_full" android:layout_width="match_parent"
                    android:layout_height="56dp" android:background="@drawable/btn_primary"
                    android:text="▣ Chiếu full cụm" android:textAllCaps="false"
                    android:textSize="14sp" android:textColor="@android:color/white" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/cast_zone_left" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="56dp"
                        android:layout_marginEnd="4dp" android:background="@drawable/btn_outline"
                        android:text="◧ Trái" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                    <Button android:id="@+id/cast_zone_right" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="56dp"
                        android:layout_marginStart="4dp" android:background="@drawable/btn_outline"
                        android:text="◨ Phải" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/btn_text" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/divider" />

            <CheckBox android:id="@+id/cb_autostart" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:textColor="@color/text_secondary"
                android:text="Tự khởi động: chiếu full cụm" />
            <Spinner android:id="@+id/spinner_autostart_app" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="@dimen/touch_min" />

            <CheckBox android:id="@+id/cb_autostart_split" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:textColor="@color/text_secondary"
                android:text="Tự khởi động: chia đôi (trái + phải)" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Spinner android:id="@+id/spinner_autostart_left" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp" android:minHeight="@dimen/touch_min"
                    android:contentDescription="App tự chiếu bên trái" />
                <Spinner android:id="@+id/spinner_autostart_right" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:minHeight="@dimen/touch_min"
                    android:contentDescription="App tự chiếu bên phải" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Tỉ lệ chia đôi cụm — dùng khi chạm ô nửa trái/nửa phải của nút nổi"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />
            <Spinner android:id="@+id/spinner_split_ratio" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="@dimen/touch_min"
                android:contentDescription="Tỉ lệ chia đôi cụm khi chiếu hai app" />

            <TextView android:id="@+id/cast_recovery_toggle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
                android:layout_marginTop="14dp" android:text="Khắc phục sự cố"
                android:textSize="@dimen/text_body" android:textColor="@color/brand" android:focusable="true"
                android:contentDescription="Mở hoặc đóng nhóm hành động khắc phục sự cố" />
            <LinearLayout android:id="@+id/cast_recovery_actions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/cast_stop" android:contentDescription="Dừng Cluster Cast và trả đồng hồ"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:background="@drawable/btn_warning_outline" android:text="Dừng — trả đồng hồ" android:textAllCaps="false"
                    android:textSize="14sp" android:textColor="@color/btn_text" />
                <Button android:id="@+id/cast_diagnostics" android:contentDescription="Mở chẩn đoán Cluster Cast chỉ đọc"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:layout_marginTop="6dp" android:background="@drawable/btn_outline" android:text="Chẩn đoán" android:textAllCaps="false"
                    android:textSize="14sp" android:textColor="@color/btn_text" />

                <Button android:id="@+id/cast_clear_cluster" android:contentDescription="Trả cụm về đồng hồ: đưa mọi app trên cụm về màn chính rồi đóng đường chiếu"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:layout_marginTop="6dp" android:background="@drawable/btn_warning_outline" android:text="Trả cụm về đồng hồ (cứu hộ)" android:textAllCaps="false"
                    android:textSize="14sp" android:textColor="@color/btn_text" />

            </LinearLayout>
        </LinearLayout>

        <!-- VietMap HUD BLE Bridge — HIDDEN (hardware not supported, research pending) -->
